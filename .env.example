# =========================================================================
# Virtual Wardrobe — example environment. Copy to .env and fill real values.
# NEVER commit .env. Secrets here are placeholders only.
# =========================================================================

# ---- Environment ----
WARDROBE_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# 32+ random bytes. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
# Comma-separated origins allowed by CORS (the web app only).
CORS_ORIGINS=http://localhost:3000
# Session cookie settings (see security decisions in README)
SESSION_COOKIE_NAME=vw_session
SESSION_TTL_SECONDS=1209600       # 14 days
SESSION_COOKIE_SECURE=false       # MUST be true behind HTTPS in prod

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wardrobe
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=change-me-postgres
# SQLAlchemy async URL (assembled from the above by config.py if left blank)
DATABASE_URL=

# ---- Redis (broker + rate-limit store) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=

# ---- Object storage (MinIO / S3-compatible) — PRIVATE buckets only ----
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # what browsers use for signed URLs
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-minio-access
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET_SCANS=vw-scans-private
S3_BUCKET_AVATARS=vw-avatars-private
S3_BUCKET_GARMENTS=vw-garments-private
S3_SIGNED_URL_TTL_SECONDS=300     # 5 min — short-lived by design

# ---- Uploads: hard limits enforced server-side ----
MAX_UPLOAD_BYTES=15728640         # 15 MB per scan image
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/heic

# ---- Auth ----
MAGIC_LINK_TTL_SECONDS=900        # 15 min
# Email delivery (dev = console/mailhog). Fill real SMTP in prod.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@virtualwardrobe.local
# Sign in with Apple (fill for real; leave blank to disable in dev)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Privacy defaults ----
# If true, raw scan images are hard-deleted after successful avatar generation
# unless the user explicitly opts to retain them.
DELETE_RAW_SCANS_AFTER_AVATAR=true

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
